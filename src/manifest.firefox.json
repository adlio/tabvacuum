{
  "manifest_version": 3,
  "name": "Aaron's Tab Vacuum",
  "short_name": "ATV",
  "description": "Find tabs fast, sort them your way, and clear duplicates, stale tabs and blank pages. Built for keyboard control.",
  "icons": {
    "16": "icons/toolbar-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "history", "notifications", "storage", "contextMenus", "activeTab", "scripting"],
  "optional_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    { "resources": ["search.html"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aaron's Tab Vacuum — Search, Sort & Clean Up",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "20": "icons/toolbar-20.png",
      "24": "icons/toolbar-24.png",
      "32": "icons/toolbar-32.png",
      "48": "icons/toolbar-48.png",
      "64": "icons/toolbar-64.png"
    },
    "theme_icons": [
      { "size": 16, "dark": "icons/toolbar-16.png", "light": "icons/toolbar-light-16.png" },
      { "size": 32, "dark": "icons/toolbar-32.png", "light": "icons/toolbar-light-32.png" },
      { "size": 64, "dark": "icons/toolbar-64.png", "light": "icons/toolbar-light-64.png" }
    ]
  },
  "options_ui": {
    "page": "options.html"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabvacuum@adlio",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "commands": {
    "close-duplicates": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Close duplicate tabs"
    },
    "merge-windows": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Merge all windows"
    },
    "sort-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Sort tabs"
    },
    "search-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Search tabs"
    },
    "close-stale": {
      "description": "Close stale tabs"
    },
    "close-blank": {
      "description": "Close blank tabs"
    }
  }
}
